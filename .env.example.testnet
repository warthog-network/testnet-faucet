# --- Required ---
# 64-char hex private key for the faucet's testnet WART keypair.
# Generate with:  npm run gen-key
# The faucet's own WART address is derived from this key at boot (never
# committed to any file, never set as a separate env var).
FAUCET_HEX_PRIVKEY=

# --- Network (fixed for this instance: testnet only) ---
NETWORK=testnet

# Public defi testnet node URL. Discovery from data.warthog.network/defi-nodes.json
# is also supported at startup; NODE_URL takes precedence when set.
NODE_URL=https://warthog-defitestnet.duckdns.org/

# --- Server ---
PORT=3000

# --- Drip formula ---
# 0.1% of the faucet's current self-balance, fee out of the 0.1%.
# recipientAmount = floor( selfBalance * (DRIP_PERCENT/100) - TX_FEE )
DRIP_PERCENT=0.1
# Fee the faucet pays on every drip. Default matches the defi node's feeE4 of 10
# (0.10% of 1 WART = 0.001 WART, rounded). The faucet's reserve pays this.
TX_FEE=0.001

# --- Rate limit ---
# 2 payments per IP per rolling 24h window (per literal IP).
RATE_LIMIT=2
WINDOW_HOURS=24

# --- Balance polling ---
# In-RAM only, no persistent storage. Poll every minute.
BALANCE_POLL_MS=60000

# --- Reverse proxy ---
# Accepted values:
#   false         — direct hosting, no proxy. req.ip is the TCP peer.
#   loopback      — nginx on the same host; trust X-Forwarded-For only if peer is loopback.
#   <CIDR>        — trust X-Forwarded-For only if peer is in the given CIDR (e.g. 10.0.0.0/8).
#   true          — trust X-Forwarded-For unconditionally. Insecure if exposed to the internet.
TRUST_PROXY=loopback

# --- CORS allowlist (comma-separated) ---
CORS_ORIGIN=https://warthog.network,http://localhost:4321
